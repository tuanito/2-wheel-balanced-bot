# build outputs
firmware/**/.pio/
**/__pycache__/
*.so
*.dylib
.pytest_cache/
# regenerable sim output
sim/results/*frames*/
sim/results/*.mp4
# secrets: the Claude API key lives in /etc/robot.env on the Pi, never in the repo
robot.env
*.env

# ML training output and the Mac venv / library (ml/setup_mac.sh)
ml/runs/
.venv/
# generated by the CAD / site scripts (robot_paths.OUT; set ROBOT_OUT to move them elsewhere)
cad_src/case/*.stl
cad_src/case/*.step
cad_src/case/*.json
cad_src/case/*.png
cad_src/case/assembly/
cad_src/case/mesh/
# regenerable CAD exports written next to their script (the kept copies are in cad/)
cad_src/wheel_adapter/*.stl
cad_src/wheel_adapter/*.step
site/files/**/*.zip.json
bom/*.xlsx
# downloaded by models/fetch_models.sh (incl. the non-redistributable MF6015 STEP)
models/bought/
models/drawings/
sim/robot_c_stairs.xml
