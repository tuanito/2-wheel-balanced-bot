# build outputs
firmware/**/.pio/
**/__pycache__/
*.so
*.dylib
.pytest_cache/
# regenerable sim output
sim/results/*frames*/
sim/results/*.mp4
# secrets: the Claude API key lives in /etc/robot.env on the Pi, never in the repo
robot.env
*.env
# generated by the CAD / site scripts (rebuild with them)
cad_src/case/*.stl
cad_src/case/*.step
cad_src/case/*.json
cad_src/case/*.png
cad_src/case/assembly/
cad_src/case/mesh/
cad_src/wheel_adapter/*.stl
cad_src/wheel_adapter/*.step
site/files/**/*.zip.json
bom/*.xlsx
